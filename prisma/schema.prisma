generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations and the ingest need a direct connection; the app can use a
  // pooled one. Locally both are the same URL.
  directUrl = env("DIRECT_URL")
}

model Season {
  id        Int     @id @default(autoincrement())
  // "2024-25" — the canonical NBA season key
  key       String  @unique
  startYear Int
  endYear   Int
  /// Has stats in it. The stat pages default to the latest such season.
  active    Boolean @default(false)

  playerStats   PlayerStats[]
  splitStats    SplitStats[]
  advancedStats AdvancedStats[]
  teamStats     TeamStats[]
  teamSplits    TeamSplitStats[]
  games         Game[]
  shots         ShotData[]
  gameLogs      PlayerGameLog[]

  @@index([startYear])
  @@map("seasons")
}

/// A franchise in one city. Relocations get their own row (Seattle is not
/// Oklahoma City); renames in the same city fold into the modern franchise.
model Team {
  id           Int    @id // NBA team id (1610612737...), or ours for teams that moved or folded
  abbreviation String @unique
  city         String
  name         String
  conference   String
  division     String
  primaryColor String @default("#1d428a")

  players      Player[]
  stats        TeamStats[]
  teamSplits   TeamSplitStats[]
  playerStats  PlayerStats[]
  splitStats   SplitStats[]
  homeGames    Game[]          @relation("home")
  awayGames    Game[]          @relation("away")
  gameLogs     PlayerGameLog[]
  shots        ShotData[]
  transactions Transaction[]

  @@index([conference, division])
  @@map("teams")
}

model Player {
  /// The NBA's person id. Only a player the matcher couldn't place keeps a
  /// hash of his basketball-reference slug instead.
  id         Int       @id
  brSlug     String?   @unique
  firstName  String
  lastName   String
  fullName   String
  position   String?
  jersey     String?
  heightIn   Int?
  weightLb   Int?
  birthDate  DateTime?
  country    String?
  college    String?
  draftYear  Int?
  draftRound Int?
  draftPick  Int?
  /// On a current NBA roster.
  active     Boolean   @default(false)
  /// Current team for active players; the last one he played for otherwise.
  teamId     Int?
  team       Team?     @relation(fields: [teamId], references: [id])

  stats         PlayerStats[]
  splitStats    SplitStats[]
  advancedStats AdvancedStats[]
  gameLogs      PlayerGameLog[]
  shots         ShotData[]
  defendedShots ShotData[]      @relation("defender")

  @@index([fullName])
  @@index([teamId, active])
  @@map("players")
}

/// Season totals for one player-season. A stat the league didn't record yet
/// (steals before 1973-74, threes before 1979-80...) is null, never 0.
model PlayerStats {
  id       Int    @id @default(autoincrement())
  playerId Int
  seasonId Int
  /// The team he finished the season with.
  teamId   Int?
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team     Team?  @relation(fields: [teamId], references: [id])

  gp   Int
  gs   Int?
  min  Float?
  pts  Int
  reb  Int?
  oreb Int?
  dreb Int?
  ast  Int?
  stl  Int?
  blk  Int?
  tov  Int?
  pf   Int?
  fgm  Int
  fga  Int
  fg3m Int?
  fg3a Int?
  ftm  Int
  fta  Int

  // Derived, stored so tables can sort on them in the database
  ppg    Float
  rpg    Float?
  apg    Float?
  fgPct  Float?
  fg3Pct Float?
  ftPct  Float?
  tsPct  Float?
  efgPct Float?
  usgPct Float?

  @@unique([playerId, seasonId, teamId])
  @@index([seasonId, ppg(sort: Desc)])
  @@index([seasonId, teamId])
  @@map("player_stats")
}

/// A player's playoff or preseason line: the same box totals as PlayerStats, plus
/// the advanced metrics BR publishes for the playoffs (preseason has none). Kept
/// apart from PlayerStats so everything reading that stays regular-season only.
model SplitStats {
  id       Int    @id @default(autoincrement())
  playerId Int
  seasonId Int
  /// 'playoffs' (basketball-reference) or 'preseason' (summed from box scores)
  kind     String
  /// The team he finished it with.
  teamId   Int?
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team     Team?  @relation(fields: [teamId], references: [id])

  gp   Int
  gs   Int?
  min  Float?
  pts  Int
  reb  Int?
  oreb Int?
  dreb Int?
  ast  Int?
  stl  Int?
  blk  Int?
  tov  Int?
  pf   Int?
  fgm  Int
  fga  Int
  fg3m Int?
  fg3a Int?
  ftm  Int
  fta  Int

  ppg    Float
  rpg    Float?
  apg    Float?
  fgPct  Float?
  fg3Pct Float?
  ftPct  Float?
  tsPct  Float?
  efgPct Float?
  usgPct Float?

  per    Float?
  ows    Float?
  dws    Float?
  ws     Float?
  ws48   Float?
  obpm   Float?
  dbpm   Float?
  bpm    Float?
  vorp   Float?
  astPct Float?
  rebPct Float?

  @@unique([playerId, seasonId, kind])
  @@index([seasonId, kind])
  @@map("split_stats")
}

/// Published advanced metrics (PER, WS, BPM, VORP...) plus our ORtg/DRtg estimate.
model AdvancedStats {
  id       Int    @id @default(autoincrement())
  playerId Int
  seasonId Int
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  per    Float?
  ortg   Float?
  drtg   Float?
  netRtg Float?
  ows    Float?
  dws    Float?
  ws     Float?
  ws48   Float?
  obpm   Float?
  dbpm   Float?
  bpm    Float?
  vorp   Float?
  astPct Float?
  rebPct Float?
  stlPct Float?
  blkPct Float?
  tovPct Float?

  @@unique([playerId, seasonId])
  @@index([seasonId])
  @@map("advanced_stats")
}

model Game {
  id         Int      @id @default(autoincrement())
  /// NBA game id ("0022600001") from 2026-27 on; basketball-reference's sort key before.
  gameCode   String   @unique
  seasonId   Int
  season     Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  date       DateTime
  homeTeamId Int
  awayTeamId Int
  homeTeam   Team     @relation("home", fields: [homeTeamId], references: [id])
  awayTeam   Team     @relation("away", fields: [awayTeamId], references: [id])
  homeScore  Int      @default(0)
  awayScore  Int      @default(0)
  period     Int      @default(4)
  /// "Final", "Final/OT", or the tip-off time for a game not played yet.
  status     String   @default("Final")
  /// preseason | regular | cup-final | play-in | playoffs. Standings and
  /// stats count regular only (NBA Cup group and knockout games are regular).
  kind       String   @default("regular")
  /// "Emirates NBA Cup · East Group A", "NBA Paris Game"...
  label      String?
  /// Points by period, OT included. Empty where no line score is on record.
  homeLine   Int[]    @default([])
  awayLine   Int[]    @default([])
  /// Each side's top performer, `{ home, away }` of `{ playerId, name, pts, reb, ast }` (a `GameLeaders`).
  leaders    Json?
  /// Where to watch and listen, from the NBA schedule: {"tv": ["ESPN"], "radio": ["SiriusXM", ...]}.
  broadcast  Json?

  gameLogs PlayerGameLog[]
  shots    ShotData[]

  @@index([date(sort: Desc)])
  @@index([seasonId, date(sort: Desc)])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@map("games")
}

model PlayerGameLog {
  id       Int      @id @default(autoincrement())
  playerId Int
  gameId   Int
  seasonId Int
  teamId   Int
  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  season   Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team     Team     @relation(fields: [teamId], references: [id])
  date     DateTime

  started   Boolean @default(false)
  min       Float   @default(0)
  pts       Int     @default(0)
  reb       Int     @default(0)
  oreb      Int     @default(0)
  dreb      Int     @default(0)
  ast       Int     @default(0)
  stl       Int     @default(0)
  blk       Int     @default(0)
  tov       Int     @default(0)
  pf        Int     @default(0)
  fgm       Int     @default(0)
  fga       Int     @default(0)
  fg3m      Int     @default(0)
  fg3a      Int     @default(0)
  ftm       Int     @default(0)
  fta       Int     @default(0)
  plusMinus Int     @default(0)

  @@unique([playerId, gameId])
  @@index([playerId, date(sort: Desc)])
  @@index([gameId])
  @@map("player_game_logs")
}

/// One shot attempt. x/y are NBA tracking coords in tenths of a foot,
/// origin at the basket, x in [-250, 250], y in [-50, 890].
/// Real shots (2026-27 on) carry the play-by-play `eventNum`; derived ones
/// (sampled to match a season's published shooting splits) leave it null.
model ShotData {
  id         Int      @id @default(autoincrement())
  playerId   Int
  gameId     Int
  seasonId   Int
  teamId     Int
  defenderId Int?
  eventNum   Int?
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  season     Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team       Team     @relation(fields: [teamId], references: [id])
  defender   Player?  @relation("defender", fields: [defenderId], references: [id])

  x          Int
  y          Int
  distanceFt Int
  made       Boolean
  value      Int      // 2 or 3
  zone       String   // "Restricted Area", "Above the Break 3", ...
  zoneArea   String   // "Center(C)", "Left Side(L)", ...
  actionType String   // "Jump Shot", "Driving Layup", ...
  period     Int
  minsLeft   Int
  secsLeft   Int
  shotClock  Float?
  defDistFt  Float?
  date       DateTime

  @@unique([gameId, eventNum])
  @@index([playerId, seasonId])
  @@index([seasonId, zone])
  @@index([teamId, seasonId])
  @@map("shot_data")
}

/// One season for one team, with who they were that year. A stat
/// basketball-reference doesn't have for the era is null.
model TeamStats {
  id       Int    @id @default(autoincrement())
  teamId   Int
  seasonId Int
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  /// That season's name ("Washington Bullets"), conference and division.
  /// No conferences before 1970-71: conference is null, division is
  /// "Eastern"/"Western" (and "Central" in 1949-50).
  name       String?
  conference String?
  division   String?

  gp     Int @default(0)
  wins   Int @default(0)
  losses Int @default(0)

  pace      Float?
  ortg      Float?
  drtg      Float?
  netRtg    Float?
  efgPct    Float?
  tsPct     Float?
  tovPct    Float?
  orebPct   Float?
  ftRate    Float?
  oppEfgPct Float?
  oppTovPct Float?
  drebPct   Float?
  sos       Float?

  // Season totals, for the per-game team table
  pts    Int?
  oppPts Int?
  reb    Int?
  oreb   Int?
  dreb   Int?
  ast    Int?
  stl    Int?
  blk    Int?
  tov    Int?
  fgm    Int?
  fga    Int?
  fg3m   Int?
  fg3a   Int?
  ftm    Int?
  fta    Int?
  pf     Int?

  // Defensive rating allowed by opponent position, e.g. {"PG":112.4,...}
  drtgByPosition Json?

  @@unique([teamId, seasonId])
  @@index([seasonId, netRtg(sort: Desc)])
  @@map("team_stats")
}

/// A team's playoff or preseason line, the TeamStats columns minus alignment.
/// Playoffs come from basketball-reference with its ratings; preseason is
/// summed from box scores and has no ratings.
model TeamSplitStats {
  id       Int    @id @default(autoincrement())
  teamId   Int
  seasonId Int
  /// 'playoffs' or 'preseason'
  kind     String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  name   String?
  gp     Int     @default(0)
  wins   Int     @default(0)
  losses Int     @default(0)

  pace      Float?
  ortg      Float?
  drtg      Float?
  netRtg    Float?
  efgPct    Float?
  tsPct     Float?
  tovPct    Float?
  orebPct   Float?
  ftRate    Float?
  oppEfgPct Float?
  oppTovPct Float?
  drebPct   Float?
  sos       Float?

  pts    Int?
  oppPts Int?
  reb    Int?
  oreb   Int?
  dreb   Int?
  ast    Int?
  stl    Int?
  blk    Int?
  tov    Int?
  fgm    Int?
  fga    Int?
  fg3m   Int?
  fg3a   Int?
  ftm    Int?
  fta    Int?
  pf     Int?

  @@unique([teamId, seasonId, kind])
  @@index([seasonId, kind])
  @@map("team_split_stats")
}

/// A signing, waiver, trade or conversion, as the NBA's transaction log lists
/// it (July 2015 on). A trade is several rows sharing a groupKey.
model Transaction {
  id          Int      @id @default(autoincrement())
  date        DateTime
  type        String // Signing | Waive | Trade | AwardOnWaivers | ContractConverted
  description String
  teamId      Int?
  team        Team?    @relation(fields: [teamId], references: [id])
  /// NBA person id. Not every player here has played, so no foreign key.
  playerId    Int?
  groupKey    String

  @@index([date(sort: Desc)])
  @@index([teamId, date(sort: Desc)])
  @@index([playerId])
  @@map("transactions")
}
